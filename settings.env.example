# The free checks (publisher AI labels and writing patterns) always run.
#
# The Claude review is a PAID Anthropic API service and is switched off.
# To switch it on, copy this file to settings.env, change "off" to "on"
# and paste your Anthropic API key after ANTHROPIC_API_KEY=.
BRIEFING_CLAUDE_REVIEW=off
ANTHROPIC_API_KEY=
# Optional: model used for the review (default claude-opus-5-5)
# BRIEFING_AI_MODEL=claude-fable-5-1
